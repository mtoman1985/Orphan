# انسخ هذا الملف إلى .env ثم ضع قيمك الحقيقية (لا ترفع .env إلى GitHub)
PORT=7861
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/clinicbot?retryWrites=true&w=majority
GEMINI_API_KEY=ضع_مفتاح_Gemini_هنا
# الربط برقم الهاتف (بدون + أو 00) — اتركه فارغاً إن أردت الربط بالباركود QR
WA_PAIR_PHONE=972599331114
# تصفير جلسة واتساب مرة واحدة فقط: ضع 1 ثم احذف المتغير بعد أول تشغيل
RESET_WA_SESSION=1
# على ويندوز يُستخدم LocalAuth تلقائياً. على لينكس/السيرفر يُستخدم RemoteAuth (MongoDB)
# WA_AUTH=local
